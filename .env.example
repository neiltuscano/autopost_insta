# f1jobs — Environment Variables
# Copy this file to .env and fill in your keys.
# Never commit .env to git.

# ── Job APIs ──────────────────────────────────────────────────────────────────
# JSearch via RapidAPI — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key_here

# Adzuna API — https://developer.adzuna.com (free tier available)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# ── Instagram Graph API ───────────────────────────────────────────────────────
# Run setup_ig_token.py --paste-token to populate these.
# Token expires ~60 days after creation — re-run to refresh.
IG_ACCESS_TOKEN=your_instagram_access_token
IG_ACCOUNT_ID=your_instagram_account_id

# ── Cloudinary (image hosting for Instagram Graph API) ───────────────────────
# Sign up free at https://cloudinary.com — grab Cloud Name from dashboard.
# Create an unsigned upload preset named "f1jobs" under Settings → Upload.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_UPLOAD_PRESET=f1jobs

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Create a Google Sheet, share it with the service account as Editor,
# then paste the Sheet ID (from the URL) here.
# Service account: f1jobs-sheets@f1jobs-506321.iam.gserviceaccount.com
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEET_URL=
